# ── Shared ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── API (apps/api) ─────────────────────────────────────────────────────────
API_PORT=4000
# MongoDB Atlas. Create a database user, add this machine's IP to the cluster's
# access list, then paste the SRV connection string here.
#   Atlas -> Cluster -> Connect -> Drivers -> Node.js
# Password must be URL-encoded if it contains @ : / ? # [ ] or %
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/landcaller?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://crm.landcaller.com

# ── Email (email module) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_DEFAULT="LandCaller CRM <no-reply@landcaller.com>"

# ── Telephony (v2, telephony module) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Where invite links point. Must be the public address users reach the app on
# (https://crm.landcaller.com in production) — the API builds the link, so leaving
# this at localhost sends invited users somewhere they cannot open.
APP_URL=http://localhost:3000

# ── Google sign-in (optional) ──────────────────────────────────────────────
# From Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Leave blank to hide the button and keep passwords only.
# The redirect URI must be registered there verbatim, for every origin you use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/session/google/callback

# ── Web (apps/web) ─────────────────────────────────────────────────────────
# Where the browser and the server reach the API.
#
# Leave NEXT_PUBLIC_API_URL unset to serve the API from this app at /api/v1 — one
# deployment, one origin, no CORS. Set it only for a split deployment, where the
# standalone Express server (apps/api) runs somewhere else.
# NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
